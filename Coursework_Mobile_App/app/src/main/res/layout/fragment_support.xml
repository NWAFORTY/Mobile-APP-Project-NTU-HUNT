<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ntu_page_background"
    android:clipChildren="false">

    <!-- Branded header: stays behind the scroll layer (lower Z / drawn first) -->
    <LinearLayout
        android:id="@+id/supportBrandedHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/support_fragment_header_bg"
        android:elevation="0dp"
        android:orientation="vertical"
        android:translationZ="0dp"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/support_brand_line"
            android:textAllCaps="true"
            android:textColor="#E6FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/support_title"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/support_tagline"
            android:textColor="#CCFFFFFF"
            android:textSize="15sp" />

        <View
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:layout_marginTop="14dp"
            android:background="@color/ntuRed" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/supportScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="24dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:translationZ="8dp">

        <LinearLayout
            android:id="@+id/supportScrollContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingBottom="24dp"
            android:paddingTop="@dimen/support_header_scroll_inset">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/supportFormCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="@dimen/support_card_header_overlap_negative"
                android:layout_marginEnd="20dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="14dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@color/ntu_leaderboard_row_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.2"
                        android:text="@string/support_intro"
                        android:textColor="@color/ntu_support_text_muted"
                        android:textSize="15sp" />

                    <!-- Category • label row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/support_category_dot" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/support_category_label"
                            android:textColor="@color/ntu_header_gradient_start"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Spinner
                        android:id="@+id/supportCategorySpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/support_category_spinner_bg"
                        android:minHeight="52dp"
                        android:paddingStart="14dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="12dp"
                        android:popupBackground="@color/white" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:hint="@string/support_message_hint"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="@color/support_message_stroke"
                        app:boxStrokeWidth="1dp"
                        app:hintTextColor="@color/ntu_support_text_muted">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/supportMessageInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="5"
                            android:textColor="@color/ntu_header_gradient_start"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/supportSubmitButton"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="22dp"
                        android:text="@string/support_submit"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/ntuRed"
                        app:cornerRadius="14dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="28dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/support_footer"
                android:textAlignment="center"
                android:textColor="@color/ntu_support_text_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
