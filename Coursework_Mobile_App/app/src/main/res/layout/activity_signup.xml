<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ntu_welcome_background">

    <View
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_alignParentTop="true"
        android:background="@color/ntuRed" />

    <View
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"
        android:background="@color/ntuRed" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomBar"
        android:layout_below="@id/topBar"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="20dp"
            android:paddingEnd="28dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NTU HUNT"
                android:textColor="@color/ntuRed"
                android:textSize="34sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="156dp"
                android:layout_height="156dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_logo_circle_gray" />

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/logoImage"
                    android:layout_width="128dp"
                    android:layout_height="128dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ntu_shield" />
            </FrameLayout>

            <EditText
                android:id="@+id/signup_username"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="14dp"
                android:background="#424242"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:padding="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA" />

            <EditText
                android:id="@+id/signup_password"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="14dp"
                android:background="#424242"
                android:hint="Password"
                android:inputType="textPassword"
                android:padding="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA" />

            <EditText
                android:id="@+id/signup_confirm_password"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="22dp"
                android:background="#424242"
                android:hint="Confirm Password"
                android:inputType="textPassword"
                android:padding="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/signup_create"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:minWidth="200dp"
                android:text="CREATE ACCOUNT"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/blue"
                app:cornerRadius="26dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/signup_back"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:minWidth="180dp"
                android:text="Back to Login"
                android:textSize="13sp"
                app:backgroundTint="@color/blue"
                app:cornerRadius="24dp" />
        </LinearLayout>
    </ScrollView>

</RelativeLayout>
